<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>rtop</AssemblyName>
    <RootNamespace>Rtop</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <PackAsTool>true</PackAsTool>
    <ToolCommandName>rtop</ToolCommandName>
    <PackageId>Rtop</PackageId>
    <Version>1.0.0</Version>
    <Authors>Elliot Hallam</Authors>
    <Description>Terminal dashboard for dotnet processes running out of git worktrees.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/elliothllm/rtop</PackageProjectUrl>
    <RepositoryUrl>https://github.com/elliothllm/rtop.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>dotnet;git-worktree;tui;dashboard;processes;macos</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console" Version="0.57.2" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
